# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# --- Bắt buộc ---
# URL project Supabase (Supabase Dashboard → Settings → API → Project URL).
# Đăng nhập (Google + email/password) do Supabase Auth quản lý; backend verify
# access token qua JWKS của project này.
SUPABASE_URL=

# --- Tùy chọn ---
DATABASE_URL=postgresql+psycopg://docuvault:docuvault@localhost:5432/docuvault
# Rỗng = mở cho mọi account. Giới hạn domain: ví dụ "congty.vn" hoặc "a.com,b.com"
ALLOWED_EMAIL_DOMAINS=
# Origin được gọi API (CORS), phân cách bằng dấu phẩy. Rỗng = tắt CORS.
# Production PHẢI khai báo (dev tự cho phép localhost/IP LAN).
CORS_ORIGINS=
# Môi trường: "dev" (mặc định) hoặc "production". Production tắt các nới lỏng
# của dev (CORS regex LAN), bật HSTS, và cảnh báo nếu TRUSTED_HOSTS = "*".
ENVIRONMENT=dev
# Host hợp lệ trong header Host (chống DNS rebinding), phân cách bằng dấu phẩy.
# "*" = không kiểm tra (dev). Production: khai báo domain thật, vd
# "api.congty.vn,congty.vn".
TRUSTED_HOSTS=*

# --- Giới hạn tài nguyên ---
# Dung lượng tối đa 1 file upload (MB)
MAX_UPLOAD_MB=50
# Loại file được phép upload (theo đuôi). MIME do server quyết định theo đuôi,
# KHÔNG tin content_type client gửi lên.
ALLOWED_UPLOAD_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,jpg,jpeg,png,gif,zip
# Tổng dung lượng tài liệu tối đa của 1 user (MB); 0 = không giới hạn
USER_STORAGE_QUOTA_MB=1024
# Giới hạn số lượt gọi mỗi phút cho từng nhóm (theo user). 0 = tắt nhóm đó.
# Mỗi lượt gọi AI là tiền thật trả nhà cung cấp AI — đừng để rỗng ở production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ORDERS_PER_MINUTE=20

# --- AI ---
# Dịch vụ AI dùng API tương thích Anthropic Messages (đang dùng GLM của z.ai).
# Token chỉ đặt ở backend, KHÔNG đưa vào Flutter/Git.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_MODEL=glm-4.6
ANTHROPIC_TIMEOUT_SECONDS=90
# OCR: mỗi trang = 1 lượt gọi AI; giới hạn số trang mỗi lần OCR + DPI render trang scan
OCR_MAX_PAGES=20
OCR_DPI=200
# Model đọc ẢNH cho trang scan (bắt buộc nếu ANTHROPIC_MODEL chỉ nhận văn bản).
# Trên gateway dev-gw.vtvlive.vn: deepseek-v4-pro đọc được ảnh (đã kiểm chứng ~99% khớp).
OCR_VISION_MODEL=deepseek-v4-pro

# --- Gói subscription + thanh toán SePay ---
# Giá mỗi lượt gọi tính năng AI + hạn mức credit/tháng của từng gói
CREDIT_COST_AI=50
PLAN_QUOTA_FREE=300
PLAN_QUOTA_PLUS=1000
PLAN_QUOTA_PRO=2500
PLAN_QUOTA_MAX=10000
PLAN_PERIOD_DAYS=30
# Fair-use cho gói Max (UI hiển thị "Unlimited"): trần credit/tháng + lượt AI/giờ
MAX_UNLIMITED_MONTHLY_CREDITS=10000
UNLIMITED_HOURLY_CALLS=20
# Secret xác thực webhook SePay: tự tạo chuỗi dài, KHÔNG commit secret thật.
# Nhập đúng chuỗi này vào phần bảo mật webhook trên trang SePay.
SEPAY_WEBHOOK_SECRET=
# Tài khoản nhận tiền nạp credit — điền số TK đầy đủ để app hiện ảnh QR.
# Rỗng = đơn vẫn tạo được nhưng không có QR (chỉ hiện thông tin dạng chữ).
SEPAY_BANK_ACCOUNT=
# Mã ngân hàng theo VietQR (MB, VCB, ICB, ACB, TCB...) hoặc BIN 6 số
SEPAY_BANK_BIN=MB
# Tên chủ tài khoản hiển thị cạnh QR
SEPAY_ACCOUNT_NAME=
